# rlbotline Worker — Environment Variables
# Copy this to .env and fill in your values

# === LINE Login ===
# The worker tries auth methods in this order:
#   1. LINE_AUTH_TOKEN (or a token persisted in the Central API session)
#   2. Email/password  — if provided here OR in the Central API session
#   3. QR code         — scan the URL printed in the worker logs / dashboard
#
# Auth token (optional fallback; normally fetched from Central API state):
LINE_AUTH_TOKEN=

# Email/password sent DIRECTLY to this worker (standalone login). Leave both
# empty to use QR login instead. A credential stored in the Central API session
# takes priority over these.
LINE_EMAIL=
LINE_PASSWORD=

# === Central API (a.k.a. the "central web" / webhook server) ===
# OPTIONAL. Leave empty to run FULLY STANDALONE — session persists to Redis (see
# below), watched chats come from WATCH_CHAT_IDS, forwards go to WEBHOOK_URL, and
# every /state/* /webhooks/* /ws/sync interaction is skipped. Set it to enable the
# dashboard / control-plane integration.
# REST endpoint that exposes /state/*, /webhooks, /ws/sync
API_BASE_URL=
# Per-instance bearer token issued by the Central API at bot creation
# (or via POST /bots/:id/rotate-token). Treat as a secret.
INSTANCE_TOKEN=
# Watched-message forward sink. In standalone mode set this to your webhook POC.
# When API_BASE_URL is set it defaults to API_BASE_URL/webhooks/forward.
WEBHOOK_URL=
# Optional: explicit Sync Hub WS URL override (defaults derived from API_BASE_URL)
# SYNC_URL=ws://localhost:3001/ws/sync

# === Redis (session persistence — NO auth) ===
# After login the LINE session (auth token + E2EE storage blob) is persisted here
# so a restart restores it instead of re-logging-in (repeated fresh logins get the
# account banned). Leave REDIS_HOST empty to disable (session in-memory only — a
# fresh login every restart; a loud warning is logged).
REDIS_HOST=
REDIS_PORT=6379
# Namespace for this account's keys ({prefix}:auth-token, {prefix}:storage).
# Containers sharing one LINE account MUST share this prefix. Defaults to
# "rlbotline:${INSTANCE_ID}" when empty.
REDIS_KEY_PREFIX=

# === Standalone forward (no Central API) ===
# Comma-separated chat IDs (groups start with "c...") to watch + forward to
# WEBHOOK_URL. Seeded into the in-memory registry at boot. Used only when
# API_BASE_URL is empty (otherwise watched chats come from the Central API).
WATCH_CHAT_IDS=

# === onix forwarding (destination server) ===
# Bank-OA messages the worker watches are POSTed to onix's NotifyLineMessage
# action. onix forwarding is DISABLED unless ONIX_API_URL + ONIX_AGENT_ID +
# ONIX_API_KEY are all set. See .docs/forwarding.md for the full contract.
# Base URL of the onix API (no trailing slash):
ONIX_API_URL=
# Path segment used as org/{ONIX_ORG} in the endpoint (usually "global"):
ONIX_ORG=global
# onix agent UUID that receives NotifyLineMessage:
ONIX_AGENT_ID=
# Basic auth — user "api", password = the API key (config'd here per request):
ONIX_API_USER=api
ONIX_API_KEY=apikey
# Onix-Application-Type header value:
ONIX_APPLICATION_TYPE=backend
# Per-request timeout for onix POSTs (ms):
ONIX_FORWARD_TIMEOUT_MS=5000

# === Bank OAs to follow + watch ===
# Comma-separated LINE @handles. The worker resolves each to a mid, follows it,
# and watches it (idempotent, runs on boot). Defaults to the three bank OAs.
BANK_OA_HANDLES=@scbconnect,@krungthaiconnext,@kbanklive

# === Instance Identity ===
INSTANCE_ID=worker-001
BOT_NAME=MyBot

# === Inbound HTTP API (standalone app: login + health) ===
# The container exposes an HTTP server on this port for driving login and
# health checks. Set HTTP_PORT=0 to disable it (pure outbound worker mode).
HTTP_PORT=3000
# Basic auth for /login/* — user "api", password = HTTP_API_KEY. When
# HTTP_API_KEY is empty the login API is UNAUTHENTICATED (a warning is logged).
HTTP_API_USER=api
HTTP_API_KEY=

# === Bot Configuration ===
COMMAND_PREFIX=!
LINE_DEVICE=IOSIPAD

# === Proxy (Anti-Ban: 1 unique proxy per bot instance) ===
# PROXY_URL=http://user:pass@ip:port
# PROXY_URL=socks5://user:pass@ip:port

# === Watched-chats forwarding (generic per-chat forward, separate from onix) ===
# Optional HMAC-SHA256 secret to sign generic watched-chat forwards
# (Standard Webhooks headers). Leave empty to disable signing.
WATCH_HMAC_SECRET=
# Per-request timeout for generic forward POSTs (ms):
WATCH_FORWARD_TIMEOUT_MS=5000

# === Rate Limiting ===
RATE_LIMIT_CALLS=5
RATE_LIMIT_WINDOW_MS=10000

# === Message Retention ===
MESSAGE_RETENTION_HOURS=24

# === PIN Wait Timeout ===
# If the LINE PIN is not completed within this window, the worker parks itself
# and reports status=stopped so the operator must start it again for a fresh PIN.
PIN_WAIT_TIMEOUT_MS=300000

# === Logging ===
LOG_LEVEL=info
