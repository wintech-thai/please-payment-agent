{
  "name": "rlbotline-worker",
  "version": "2.0.0",
  "description": "rlbotline LINE Selfbot Worker — Multi-Tenant SaaS Bot Container",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test scripts/test-units.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run typecheck && bun run test",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:migrate": "cd packages/api && bun run db:migrate",
    "db:reset": "docker compose -f docker-compose.db.yml down -v && rm -rf data/postgres && docker compose -f docker-compose.db.yml up -d",
    "docker:build": "docker build -t rlbotline-worker .",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:stop": "docker compose -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f worker"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@^2.18.0",
    "@evex/linejs-types": "npm:@jsr/evex__linejs-types@^2.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}