# Copy to .env before `docker compose up`.

# Shared secret: the worker requires it on /login/*, poc-app sends it. Any string.
HTTP_API_KEY=poc-secret

# LINE account identity (also the default Redis session key prefix).
INSTANCE_ID=poc-001

# Target group chat id(s) to watch + forward, comma-separated (groups start "c...").
# Leave empty on first run; discover the id from logs, then set it (see README).
WATCH_CHAT_IDS=

# Optional: fill these to auto-login with email/password at worker boot instead of
# using the UI. Leave empty to drive login from the POC page.
LINE_EMAIL=
LINE_PASSWORD=

# ONIX simulator (poc-app stands in as the ONIX destination). Defaults work as-is;
# the worker forwards watched bank-OA messages here as NotifyLineMessage calls.
ONIX_AGENT_ID=00000000-0000-0000-0000-000000000001
ONIX_API_KEY=apikey
# Bank OAs the worker follows + watches (their messages go to ONIX):
BANK_OA_HANDLES=@scbconnect,@krungthaiconnext,@kbanklive
