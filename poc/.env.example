# Copy to .env before `docker compose up`.

# Shared secret: the worker requires it on /login/*, poc-app sends it. Any string.
HTTP_API_KEY=poc-secret

# LINE account identity (also the default Redis session key prefix).
INSTANCE_ID=poc-001

# Target group chat id(s) to watch + forward, comma-separated (groups start "c...").
# Leave empty on first run; discover the id from logs, then set it (see README).
WATCH_CHAT_IDS=

# Optional: fill these to auto-login with email/password at worker boot instead of
# using the UI. Leave empty to drive login from the POC page.
LINE_EMAIL=
LINE_PASSWORD=

# ONIX simulator (poc-app stands in as the ONIX destination). Defaults work as-is;
# the worker forwards watched bank-OA messages here as NotifyLineMessage calls.
ONIX_AGENT_ID=00000000-0000-0000-0000-000000000001
ONIX_API_KEY=apikey
# === Logging ===
# debug = log ทุกระดับ (รวม forward/onix ok + เหตุผลที่ข้ามข้อความ); prod ใช้ info
LOG_LEVEL=debug
# 1 = dump ทุก raw op จาก sync() ลง **ไฟล์เท่านั้น** ./logs/log-DD-MM-YYYY.log
# (ไม่ออก console, ไม่ขึ้นกับ LOG_LEVEL) — ใช้หา chatId/mid ของ OA และกลุ่ม
RAW_OP_LOG=1

# Bank OA MIDs to watch as `oa` → ONIX. Verified against the account's contacts at
# boot: a MID already added is watched (with its real name logged); a MID not added
# is skipped (never auto-followed — the customer adds it themselves). Comma-separated.
#   scb       = u4ca19114ed596ee2f4e63335ec7143fb   (verified live → "SCB Connect")
#   kbank     = u8cc52e369d2bca4a5ce8c506170c712e   (from another device — verify in the log)
#   krungthai = uce372f6ada1d1a0855973fefc2942f9a   (from another device — verify in the log)
# Boot log: "Configured OA watched (verified contact)" = ใช้งานได้ /
#           "Configured OA not in contacts — skipped"  = ต้อง add OA นั้นในแอป LINE ก่อน
BANK_OA_MIDS=u4ca19114ed596ee2f4e63335ec7143fb,u8cc52e369d2bca4a5ce8c506170c712e,uce372f6ada1d1a0855973fefc2942f9a

# @handle auto-follow (unreliable — findContactByUserid can't resolve OA @basic-ids):
BANK_OA_HANDLES=@scbconnect,@krungthaiconnext,@kbanklive
